{
  "version": "1.0",
  "pipeline_id": "pipeline",
  "name": "Data pipeline",
  "description": "",
  "owners": [],
  "tags": [],
  "schedule": {
    "cron": "0 2 * * *"
  },
  "timezone": "UTC",
  "start_date": "2025-01-01T00:00:00Z",
  "catchup": false,
  "concurrency": 1,
  "retry_policy": {
    "retries": 2,
    "delay_seconds": 60,
    "exponential_backoff": true
  },
  "timeout_policy": {
    "task_seconds": 300,
    "pipeline_seconds": 3600
  },
  "parameters": {},
  "sources": [
    {
      "asset": "orders",
      "incremental_field": null,
      "window": "all"
    }
  ],
  "destinations": [
    {
      "asset": "analytics",
      "mode": "replace",
      "key": []
    }
  ],
  "tasks": [
    {
      "id": "read_orders",
      "type": "ingestion",
      "capability": "ingest.csv@1",
      "inputs": [
        "asset:orders"
      ],
      "outputs": [],
      "parameters": {},
      "dependencies": [],
      "retries": null,
      "timeout": null,
      "resources": {
        "cpu": 1.0,
        "memory_mb": 512,
        "max_rows": 100000
      },
      "failure_behavior": "stop",
      "quality_checks": []
    },
    {
      "id": "deduplicate",
      "type": "transformation",
      "capability": "transform.deduplicate@1",
      "inputs": [
        "task:read_orders"
      ],
      "outputs": [],
      "parameters": {
        "keys": [
          "order_id"
        ]
      },
      "dependencies": [
        "read_orders"
      ],
      "retries": null,
      "timeout": null,
      "resources": {
        "cpu": 1.0,
        "memory_mb": 512,
        "max_rows": 100000
      },
      "failure_behavior": "stop",
      "quality_checks": []
    },
    {
      "id": "write_analytics",
      "type": "output",
      "capability": "output.jsonl@1",
      "inputs": [
        "task:deduplicate"
      ],
      "outputs": [
        "asset:analytics"
      ],
      "parameters": {},
      "dependencies": [
        "deduplicate"
      ],
      "retries": null,
      "timeout": null,
      "resources": {
        "cpu": 1.0,
        "memory_mb": 512,
        "max_rows": 100000
      },
      "failure_behavior": "stop",
      "quality_checks": []
    }
  ],
  "dependencies": [],
  "quality_rules": [],
  "governance_rules": [],
  "notifications": [],
  "slas": [],
  "lineage": [
    {
      "source": "asset:orders",
      "destination": "task:read_orders"
    },
    {
      "source": "task:deduplicate",
      "destination": "task:write_analytics"
    },
    {
      "source": "task:read_orders",
      "destination": "task:deduplicate"
    },
    {
      "source": "task:write_analytics",
      "destination": "asset:analytics"
    }
  ],
  "resources": {
    "cpu": 1.0,
    "memory_mb": 512,
    "max_rows": 100000
  },
  "secrets": [],
  "execution_policy": {
    "environment": "dev",
    "idempotent": true,
    "schema_evolution": "reject"
  },
  "approval_requirements": {
    "production": true,
    "external_writes": true,
    "destructive_writes": true
  }
}
